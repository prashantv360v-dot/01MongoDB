<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
</head>
<body>
    <div class="w-full h-screen p-5 bg-zinc-900 text-white"> 
        <a class="text-blue-500" href="/read">read User</a>

        <form action="/update/<%= user.id %>" method="post">
            <h1 class="text-3xl p-3 mb-5 ">Update User</h1>
            <input class="px-2 py-2 border-2 border-zinc-800 outline-none rounded-lg bg-transparent" name="name" type="text" placeholder="Name" value="<%= user.name %>">
            <input class="px-2 py-2 border-2 border-zinc-800 outline-none rounded-lg bg-transparent" name="email" type="text" placeholder="email" value="<%= user.email %>">
            <input class="px-2 py-2 border-2 border-zinc-800 outline-none rounded-lg bg-transparent" name="image" type="text" placeholder="image-url" value="<%= user.image %>">
            <input class="py-2 px-2 ml-3 bg-yellow-500 text-black border-2 border-zinc-800 rounded-lg hover:bg-blue-600 cursar-pointer" type="submit" value="Update User">
        </form>
    </div>
</body>
</html>