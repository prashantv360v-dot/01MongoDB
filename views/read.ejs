<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
</head>
<body>
    <div class="w-full h-screen p-5 bg-zinc-900 text-white"> 
        <a class="text-blue-500 mb-10" href="./">go back home page</a>
        <h1 class="p-4 text-3xl mb-5">Read users</h1>
        <div class="users flex gap-5 flex-wrap">
            <% if(users.length >0){ %>

             <% users.forEach(function(user){ %>
                <div class="user w-72 p-4 bg-zinc-800 rounded-lg">
                <div class="w-full h-72 rounded-lg bg-zinc-700 overflow-hidden">
                    <img class="w-full h-full object-cover " src="<%= user.image %>">
                    </div>
                    <h3 class="text-xl mt-3 tracking-tighter"><%= user.name %></h3>
                    <h5 class="text-zinc-500"><%= user.email %></h5>
                    <div class="flex gap-3 mt-10">
                        <a class="text-zinc-200 " href="/edit/<%= user.id %>">Edit User</a>
                        <a class="text-red-500" href="/delete/<%= user._id %>">Delete User</a>
                    </div>
                </div>
            <% }) %> 
        <% } else { %>
            <h3 class="text-2xl text-orange-500">No users yet</h3>
      <%  } %>
        
        </div>
    </div>
</body>
</html>